NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/secure-vault?retryWrites=true&w=majority
MONGODB_DATABASE=secure-vault
CORS_ORIGIN=http://localhost:8000
# Production combined service: SERVE_FRONTEND=true, TRUST_PROXY_HOPS=1,
# SESSION_COOKIE_SAME_SITE=lax; CORS_ORIGIN must be the exact HTTPS site origin.
# On Render, omit CORS_ORIGIN to use RENDER_EXTERNAL_URL automatically.
SERVE_FRONTEND=false
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
SENSITIVE_ACTION_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_ACTION_RATE_LIMIT_MAX=30
AUTH_NONCE_TTL_MS=300000
SESSION_TTL_MS=86400000
ENCRYPTED_ASSET_MAX_BYTES=26214400
GRIDFS_BUCKET_NAME=encryptedAssets
REQUIRE_KYC_BEFORE_SHARING=false
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x87becA5241e43607ce2983608B1D479f97cD9a05
EXPECTED_CHAIN_ID=11155111

# Normal runtime uses Sepolia only. No deployer private key is needed by the API.
